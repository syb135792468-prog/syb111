# 环境标识
ENVIRONMENT=development
LOG_LEVEL=INFO

# 讯飞星火 API
SPARK_APP_ID=你的APPID
SPARK_API_KEY=你的APIKey
SPARK_API_SECRET=你的APISecret

# 讯飞 SeeDance 多模态 API
SEEDANCE_API_KEY=你的SeeDance密钥

# DeepSeek API（主模型）
DEEPSEEK_API_KEY=你的DeepSeek密钥

# 火山引擎方舟 API（备用模型 glm-5.2，ark- 前缀密钥）
GLM_API_KEY=你的方舟ark密钥
GLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
GLM_MODEL=glm-5.2
GLM_ENDPOINT_ID=

# 火山引擎语音合成 TTS（视频配音用，属于"语音技术"产品线，与方舟 LLM 鉴权不同）
TTS_ENABLED=true
TTS_APP_ID=你的语音合成AppID
TTS_ACCESS_TOKEN=你的语音合成AccessToken
TTS_DEFAULT_VOICE_ID=zh_female_wanwanxiaohe_moon_bigtts

# 科大讯飞 超拟人合成 TTS（WebSocket，主用；火山TTS自动降级为备用）
# 鉴权信息从讯飞控制台"超拟人合成"产品线获取，与 SPARK_*（Embedding用）独立
# 注意：APIPassword（ak- 前缀）是 WebSocket Bearer 鉴权用，与 APIKey/APISecret（HMAC 鉴权用）不同
# 音色名形如 x6_lingyuyan_pro，非 legacy xiaoyan；可用音色见控制台"超拟人合成"音色列表
TTS_XFYUN_APP_ID=你的讯飞超拟人AppID
TTS_XFYUN_API_KEY=你的讯飞超拟人APIKey
TTS_XFYUN_API_SECRET=你的讯飞超拟人APISecret
TTS_XFYUN_API_PASSWORD=你的讯飞超拟人APIPassword（ak-前缀）
TTS_XFYUN_WS_URL=wss://cbm01.cn-huabei-1.xf-yun.com/v1/private/mcd9m97e6
TTS_XFYUN_VOICE_ID=x6_lingyuyan_pro
TTS_XFYUN_SERVICE_PARAM=mcd9m97e6

# 火山方舟视觉理解模型（多模态代码识别用）
# 开通步骤：方舟控制台 -> 模型广场 -> 视觉理解模型 -> 开通 doubao-seed-2-1-turbo
# 端点必须用 /api/v3（标准端点），不是 /api/coding/v3（coding 端点只认 glm-5.2）
# 注意模型 ID 用横线 2-1 不是点号 2.1，且必须带日期后缀 -260628
ARK_VISION_API_KEY=你的方舟Key（ark-前缀，与 GLM_API_KEY 同一个）
ARK_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VISION_MODEL=doubao-seed-2-1-turbo-260628

# 讯飞图片理解 WebApi（多模态代码识别用，WebSocket + 签名鉴权）
# 开通步骤：讯飞控制台 -> 图像理解服务 -> 开通，获取 APPID/APIKey/APISecret
# domain 选 imagev3（高级版，效果更好）或 general（基础版）
XF_VISION_APP_ID=你的讯飞APPID
XF_VISION_API_KEY=你的讯飞APIKey
XF_VISION_API_SECRET=你的讯飞APISecret
XF_VISION_DOMAIN=imagev3

# 视觉模型 provider 切换：ark(火山方舟) / xf(讯飞)
VISION_PROVIDER=xf
# 若在控制台创建了推理接入点，填 ep-xxx 并留空上面模型名
# ARK_VISION_ENDPOINT_ID=ep-xxxxxxxx

# 数据库
DATABASE_URL=sqlite:///./data/database.db


EMBEDDING_API_KEY=你刚拿到的Embedding专用Key
EMBEDDING_BASE_URL=你刚拿到的接口地址

# 内容审核（讯飞 audit 文本审核 API，独立服务 audit.iflyaisol.com，复用 SPARK_API_KEY）
# 注意：讯飞 OpenAI 兼容主机 spark-api-open.xf-yun.com/v1 没有 moderations 端点（404），
#       审核走 audit.iflyaisol.com/audit/v2/auditText，payload/response 格式与 OpenAI 不同
# 赛题对齐：A3 要求内容安全过滤，默认开启
# 退路 B：若未开通讯飞审核服务，设 false 关闭审核路径，靠 DeepSeek/GLM 自带的
#         content_policy_violation 拦截（llm_client.py 已内置），实际仍有内容安全效果
CONTENT_MODERATION_ENABLED=true
CONTENT_MODERATION_TIMEOUT=5
