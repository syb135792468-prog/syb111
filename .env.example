# 环境标识
ENVIRONMENT=development
LOG_LEVEL=INFO

# 讯飞星火 API
SPARK_APP_ID=你的APPID
SPARK_API_KEY=你的APIKey
SPARK_API_SECRET=你的APISecret

# 讯飞 SeeDance 多模态 API
SEEDANCE_API_KEY=你的SeeDance密钥

# DeepSeek API（主模型）
DEEPSEEK_API_KEY=你的DeepSeek密钥

# 火山引擎方舟 API（备用模型 glm-5.2，ark- 前缀密钥）
GLM_API_KEY=你的方舟ark密钥
GLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
GLM_MODEL=glm-5.2
GLM_ENDPOINT_ID=

# 火山引擎语音合成 TTS（视频配音用，属于"语音技术"产品线，与方舟 LLM 鉴权不同）
TTS_ENABLED=true
TTS_APP_ID=你的语音合成AppID
TTS_ACCESS_TOKEN=你的语音合成AccessToken
TTS_DEFAULT_VOICE_ID=zh_female_wanwanxiaohe_moon_bigtts

# 火山方舟视觉理解模型（多模态代码识别用）
# 开通步骤：方舟控制台 → 模型广场 → 视觉理解模型 → 开通 doubao-1.5-vision-pro
# 端点必须用 /api/v3（标准端点），不是 /api/coding/v3（coding 端点只认 glm-5.2）
ARK_VISION_API_KEY=你的方舟Key（ark-前缀，与 GLM_API_KEY 同一个）
ARK_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VISION_MODEL=doubao-1.5-vision-pro-32k
# 若在控制台创建了推理接入点，填 ep-xxx 并留空上面模型名
# ARK_VISION_ENDPOINT_ID=ep-xxxxxxxx

# 数据库
DATABASE_URL=sqlite:///./data/database.db


EMBEDDING_API_KEY=你刚拿到的Embedding专用Key
EMBEDDING_BASE_URL=你刚拿到的接口地址
